<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <lang.parserDefinition
                language="El"
                implementationClass="com.aemtools.lang.el.ElParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="El"
                implementationClass="com.aemtools.lang.el.highlight.ElHighlighterFactory"/>

        <multiHostInjector implementation="com.aemtools.lang.el.ElInjector"/>
        <lang.fileViewProviderFactory
                language="El"
                implementationClass="com.aemtools.lang.el.file.ElViewProviderFactory"/>

        <lang.braceMatcher language="El"
                           implementationClass="com.aemtools.lang.el.editor.ElBraceMatcher"/>
        <lang.quoteHandler language="El"
                           implementationClass="com.aemtools.lang.el.editor.ElQuoteHandler"/>
        <typedHandler implementation="com.aemtools.lang.el.editor.ElTypedHandler"/>
        <backspaceHandlerDelegate implementation="com.aemtools.lang.el.editor.ElBackspaceHandler"/>
    </extensions>
</idea-plugin>
