<idea-plugin url="https://www.jetbrains.com/idea">
    <extensions defaultExtensionNs="com.intellij">
        <fileType language="Cd"
                  extensions="cd"
                  name="Clientlib definition"
                  implementationClass="com.aemtools.lang.clientlib.file.CdFileType"
                  fieldName="INSTANCE"/>
        <lang.parserDefinition
                language="Cd"
                implementationClass="com.aemtools.lang.clientlib.CdParserDefinition"/>
        <completion.contributor
                language="Cd"
                implementationClass="com.aemtools.completion.clientlib.CdCompletionContributor"/>

        <lang.substitutor
                language="TEXT"
                implementationClass="com.aemtools.lang.clientlib.CdLanguageSubstitutor"/>
        <psi.referenceContributor
                language="Cd"
                implementation="com.aemtools.reference.clientlib.CdReferenceContributor"/>
        <lang.commenter
                language="Cd"
                implementationClass="com.aemtools.lang.clientlib.editor.CdCommenter"/>
        <lang.syntaxHighlighterFactory
                language="Cd"
                implementationClass="com.aemtools.lang.clientlib.highlight.CdHighlighterFactory"/>

        <lang.parserDefinition
                language="El"
                implementationClass="com.aemtools.lang.el.ElParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="El"
                implementationClass="com.aemtools.lang.el.highlight.ElHighlighterFactory"/>

        <multiHostInjector implementation="com.aemtools.lang.el.ElInjector"/>
        <lang.fileViewProviderFactory
                language="El"
                implementationClass="com.aemtools.lang.el.file.ElViewProviderFactory"/>

        <lang.braceMatcher language="El"
                           implementationClass="com.aemtools.lang.el.editor.ElBraceMatcher"/>
        <lang.quoteHandler language="El"
                           implementationClass="com.aemtools.lang.el.editor.ElQuoteHandler"/>

        <localInspection
                language="HTML"
                enabledByDefault="true"
                hasStaticDescription="true"
                implementationClass="com.aemtools.inspection.html.MessedDataSlyAttributeInspection"/>

        <localInspection
                language="HTML"
                enabledByDefault="true"
                hasStaticDescription="true"
                implementationClass="com.aemtools.inspection.html.RedundantDataSlyUnwrapInspection"/>

        <localInspection
                language="HTML"
                enabledByDefault="true"
                hasStaticDescription="true"
                implementationClass="com.aemtools.inspection.html.RedundantElInspection"/>

        <localInspection
                language="XML"
                enabledByDefault="true"
                hasStaticDescription="true"
                implementationClass="com.aemtools.inspection.xml.AemMissedCqNamespaceInspection"/>

        <implicitUsageProvider implementation="com.aemtools.codeinsight.xml.schema.CqNamespaceImplicitUsageProvider"/>

        <lang.parserDefinition
                language="JcrProperty"
                implementationClass="com.aemtools.lang.jcrproperty.JcrPropertyParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="JcrProperty"
                implementationClass="com.aemtools.lang.jcrproperty.highlight.JpHighlighterFactory"/>

        <completion.contributor
                language="JcrProperty"
                implementationClass="com.aemtools.completion.small.clientlibraryfolder.JcrClientLibraryFolderCompletionContributor"/>
        <completion.contributor
                language="JcrProperty"
                implementationClass="com.aemtools.completion.small.component.JcrCqComponentCompletionContributor"/>

        <multiHostInjector implementation="com.aemtools.lang.jcrproperty.JcrPropertyInjector"/>

        <lang.braceMatcher language="JcrProperty"
                           implementationClass="com.aemtools.lang.jcrproperty.editor.JpBraceMatcher"/>
        <lang.documentationProvider
                language="JcrProperty" order="first"
                implementationClass="com.aemtools.documentation.clientlibs.ClientlibsFolderDocumentationProvider"/>

        <colorSettingsPage implementation="com.aemtools.ide.jcrproperty.JpColorsAndFontsPage"/>
        <fileType name="JcrProperty"
                  language="JcrProperty"
                  implementationClass="com.aemtools.lang.jcrproperty.file.JpFileType"/>

        <lang.elementManipulator implementationClass="com.aemtools.lang.clientlib.manipulator.CdIncludeManipulator"
                                 forClass="com.aemtools.lang.clientlib.psi.CdInclude"/>
        <annotator language="XML"
                   implementationClass="com.aemtools.codeinsight.xml.JcrPrimaryTypeAnnotator"/>
    </extensions>
</idea-plugin>
